# Database - Use PlanetScale or Supabase (Postgres with Prisma adapter)
DATABASE_URL="mysql://user:password@host:port/database"

# Clerk Auth (can be replaced with Supabase Auth)
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_xxx
CLERK_SECRET_KEY=sk_test_xxx
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_AFTER_SIGN_IN_URL=/
NEXT_PUBLIC_CLERK_AFTER_SIGN_UP_URL=/

# Mux Video Streaming
MUX_TOKEN_ID=xxx
MUX_TOKEN_SECRET=xxx

# UploadThing (file uploads - can be replaced with Supabase Storage)
UPLOADTHING_SECRET=sk_live_xxx
UPLOADTHING_APP_ID=xxx

# Stripe Payments
STRIPE_API_KEY=sk_test_xxx
STRIPE_WEBHOOK_SECRET=whsec_xxx
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Teacher ID (for initial admin access)
NEXT_PUBLIC_TEACHER_ID=user_xxx
